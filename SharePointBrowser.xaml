<Window x:Class="PsConsoleHost.SharePointBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PsConsoleHost.Services"
        Title="Ouvrir depuis SharePoint" Height="600" Width="900"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête avec bouton de connexion -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ConnectButton" 
                    Content="🔐 Se connecter à SharePoint" 
                    Style="{StaticResource ModernButton}"
                    Click="ConnectButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="DisconnectButton" 
                    Content="🚪 Déconnexion" 
                    Style="{StaticResource ModernButton}"
                    Click="DisconnectButton_Click"
                    Margin="8,0,8,0"
                    Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" 
                       Text="Vérification de la connexion..." 
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Contenu principal : Sites et fichiers -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des sites -->
            <Border Grid.Column="0" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="1"
                    Background="{StaticResource BackgroundSecondary}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" 
                               Text="Sites SharePoint" 
                               FontWeight="Bold"
                               Padding="8,8"
                               Background="{StaticResource BackgroundTertiary}"/>
                    <ListBox x:Name="SitesListBox" 
                             Grid.Row="1"
                             SelectionChanged="SitesListBox_SelectionChanged"
                             Background="{StaticResource BackgroundSecondary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" 
                                           Padding="8,4"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- GridSplitter pour redimensionner -->
            <GridSplitter Grid.Column="1" 
                         Width="4"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Background="{StaticResource BorderColor}"
                         Cursor="SizeWE"
                         ResizeDirection="Columns"
                         ShowsPreview="False">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="{StaticResource BorderColor}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- Arborescence des dossiers et fichiers -->
            <Border Grid.Column="2" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="1"
                    Background="{StaticResource BackgroundSecondary}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" 
                               Text="Arborescence des scripts (.ps1)" 
                               FontWeight="Bold"
                               Padding="8,8"
                               Background="{StaticResource BackgroundTertiary}"/>
                    <TreeView x:Name="FolderTreeView" 
                             Grid.Row="1"
                             SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                             Background="{StaticResource BackgroundSecondary}"
                             Foreground="{StaticResource TextPrimary}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:SharePointFolder}" ItemsSource="{Binding Items}">
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <TextBlock Text="📁" Margin="0,0,6,0" FontSize="14"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" 
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type local:SharePointFile}">
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <TextBlock Text="📄" Margin="0,0,6,0" FontSize="14"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>
        </Grid>

        <!-- Barre de progression -->
        <ProgressBar x:Name="ProgressBar" 
                     Grid.Row="2" 
                     Height="4" 
                     Margin="0,12,0,0"
                     Visibility="Collapsed"
                     IsIndeterminate="True"/>

        <!-- Boutons d'action -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Annuler" 
                    Style="{StaticResource ModernButton}"
                    Click="CancelButton_Click"
                    Margin="0,0,8,0"/>
            <Button Content="Ouvrir" 
                    x:Name="OpenButton"
                    Style="{StaticResource ModernButton}"
                    Click="OpenButton_Click"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>

