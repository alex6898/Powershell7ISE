<Application x:Class="PsConsoleHost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Palette de couleurs moderne -->
    <SolidColorBrush x:Key="BackgroundDark" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="BackgroundHover" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="BorderColor" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="BorderColorHover" Color="#909090"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#505050"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#107C10"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#D83B01"/>
    <SolidColorBrush x:Key="EditorBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ConsoleBackground" Color="#010409"/>
    <SolidColorBrush x:Key="PromptColor" Color="#7EE787"/>
    
    <!-- Style pour les boutons modernes -->
    <Style x:Key="ModernButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource BackgroundHover}"/>
          <Setter Property="BorderBrush" Value="{StaticResource BorderColorHover}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{StaticResource BackgroundTertiary}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    
    <!-- Style pour les MenuItems dans les ContextMenus -->
    <Style TargetType="MenuItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource BackgroundHover}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    
    <!-- Style pour les ContextMenus -->
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    
  </Application.Resources>
</Application>